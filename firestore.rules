rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function getRole() {
      return request.auth.token.role;
    }
    function isTenant(tid) {
      return isAuth() && request.auth.token.tenantId == tid;
    }

    // Roles com acesso administrativo total
    function isMaster(tid) {
      return isTenant(tid) && getRole() == 'master';
    }

    // Roles que podem gerenciar cadência e configurações de time
    function isManager(tid) {
      return isTenant(tid) && (getRole() == 'master' || getRole() == 'manager');
    }

    // BDR: cria leads
    function isBdr(tid) {
      return isTenant(tid) && (getRole() == 'master' || getRole() == 'manager' || getRole() == 'bdr');
    }

    // SDR: executa cadência
    function isSdr(tid) {
      return isTenant(tid) && (getRole() == 'master' || getRole() == 'manager' || getRole() == 'sdr');
    }

    // Rep: recebe handoffs e fecha negócios
    function isRep(tid) {
      return isTenant(tid) && (getRole() == 'master' || getRole() == 'manager' || getRole() == 'rep');
    }

    // Design: apenas fila de projetos (sem gamificação)
    function isDesign(tid) {
      return isTenant(tid) && getRole() == 'design';
    }

    // Qualquer autenticado do tenant (inclusive viewer e design)
    function isAnyRole(tid) {
      return isTenant(tid);
    }

    // Roles operacionais (excluindo viewer e design)
    function isOperational(tid) {
      return isTenant(tid) && getRole() != 'viewer' && getRole() != 'design';
    }

    // Papéis sem "assinatura" própria (nunca são bdrId/assignedSdrId/assignedRepId/owner
    // de um deal) — tratados como leitura ampla nas regras de deals, igual ao manager
    // (decisão confirmada com o Alan, 22/08: sem essa exceção, Viewer e Design
    // ficariam sem ver nenhum negócio).
    function canSeeAllDeals(tid) {
      return isManager(tid) || isDesign(tid) || (isTenant(tid) && getRole() == 'viewer');
    }

    // Participante de um deal: verifica participantIds (mantido pela CF
    // onDealParticipantsChanged) E, em paralelo, os 4 campos de origem
    // (owner/bdrId/assignedSdrId/assignedRepId) diretamente — não só por
    // redundância defensiva, mas porque participantIds só existe depois que a
    // CF roda; um deal recém-criado por um caminho que não passa pelo client
    // (ex.: Admin SDK) fica sem o campo até a 1ª sincronização, e a leitura não
    // pode depender dessa corrida.
    function isDealParticipant(data) {
      return request.auth.uid in data.get('participantIds', [])
        || request.auth.uid == data.get('owner', '')
        || request.auth.uid == data.get('bdrId', '')
        || request.auth.uid == data.get('assignedSdrId', '')
        || request.auth.uid == data.get('assignedRepId', '');
    }

    // Leitura: manager/design/viewer veem tudo; os demais só o que participam.
    function canReadDeals(tid, data) {
      return canSeeAllDeals(tid) || (isTenant(tid) && isDealParticipant(data));
    }

    // Edição: só master/manager têm bypass total — diferente da leitura,
    // Viewer/Design NUNCA editam (isOperational já os exclui; usar
    // canSeeAllDeals aqui seria dar edição a quem só devia ter visão).
    // Confirmado com o Alan (22/08): TODOS os 3 papéis que já assinaram o card
    // (BDR/SDR/Rep) podem editar, não só quem tem o bastão agora — por isso o
    // gate é isDealParticipant, não responsibleId.
    function canEditDeal(tid, data) {
      return isManager(tid) || (isOperational(tid) && isDealParticipant(data));
    }

    function tokenProducts() {
      return request.auth.token.productIds is list && request.auth.token.productIds.size() > 0
        ? request.auth.token.productIds
        : ['wizmart'];
    }

    function canAccessProduct(productId) {
      return productId == null || productId == 'all' || tokenProducts().hasAny([productId]);
    }

    function canAccessDocProduct(data) {
      return canAccessProduct(data.get('productId', 'wizmart'));
    }

    function canAccessDocProducts(data) {
      return data.get('productIds', ['wizmart']).hasAny(tokenProducts());
    }

    function requestProductAllowed() {
      return canAccessProduct(request.resource.data.get('productId', 'wizmart'));
    }

    function requestProductsAllowed() {
      return request.resource.data.get('productIds', ['wizmart']).hasAny(tokenProducts());
    }

    // cohortKeys não podem ser escritos diretamente pelo cliente
    function notWritingCohortKeys() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cohortKeys']);
    }

    // ── Tenant Root ────────────────────────────────────────────────────────────
    match /tenants/{tid} {

      // Deals / Negócios
      // design: somente leitura
      match /deals/{dealId} {
        allow read:   if canReadDeals(tid, resource.data) && canAccessDocProduct(resource.data);
        // Todo usuário operacional pode criar um card — a restrição de
        // participação vale só para EDIÇÃO de cards já existentes (confirmado
        // com o Alan, 22/08). Antes: isBdr(tid) (só master/manager/bdr) negava
        // a criação pro SDR mesmo o client já tratando esse caso.
        allow create: if isOperational(tid) && requestProductAllowed();
        allow update: if canEditDeal(tid, resource.data)
                      && canAccessDocProduct(resource.data)
                      && requestProductAllowed()
                      && notWritingCohortKeys();
        allow delete: if isMaster(tid);
      }

      // Funnels (configurados pelo admin, lidos por todos)
      match /funnels/{funnelId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        allow write:  if isManager(tid) && requestProductAllowed();
      }

      // Contatos e Empresas
      // design: leitura em companies (exibir nome da empresa no card de projeto)
      match /contacts/{contactId} {
        allow read:   if isAnyRole(tid) && canAccessDocProducts(resource.data);
        allow write:  if isOperational(tid) && requestProductsAllowed();
      }
      match /companies/{companyId} {
        allow read:   if isAnyRole(tid) && canAccessDocProducts(resource.data);
        allow write:  if isOperational(tid) && requestProductsAllowed();
      }

      // Coleção legada de sellers (compatibilidade v1)
      match /sellers/{sellerId} {
        allow read:   if isAnyRole(tid);
        allow write:  if isMaster(tid);
      }

      // Coleção legada de stages (compatibilidade v1)
      match /stages/{stageId} {
        allow read:   if isAnyRole(tid);
        allow write:  if isManager(tid);
      }

      // Usuários
      match /users/{userId} {
        allow read:  if isAnyRole(tid) && (request.auth.uid == userId || canAccessDocProducts(resource.data));
        allow update: if (isMaster(tid) && requestProductsAllowed()) || (isTenant(tid) && request.auth.uid == userId && requestProductsAllowed());
        allow create: if isMaster(tid) && requestProductsAllowed();
        allow delete: if isMaster(tid);
      }

      // Activities v2 — leitura por todos; escrita apenas via Cloud Functions
      match /activities/{activityId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        // Registro manual pelo card (email/whatsapp/reunião): papel operacional
        // cria/edita apenas a própria atividade. Cloud Functions seguem podendo
        // escrever via Admin SDK (ignoram as rules).
        allow create: if isOperational(tid)
                         && request.resource.data.userId == request.auth.uid
                         && requestProductAllowed();
        allow update: if isOperational(tid)
                         && resource.data.userId == request.auth.uid
                         && request.resource.data.userId == request.auth.uid
                         && requestProductAllowed();
        allow delete: if isMaster(tid);
      }

      // Feed de atividade legado
      match /activity/{activityId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        allow write:  if false;
      }

      // Handoffs — SDR cria, Rep lê e aceita via Callable
      match /handoffs/{handoffId} {
        allow read:   if isOperational(tid) && canAccessDocProduct(resource.data);
        allow create: if isSdr(tid) && requestProductAllowed();
        allow update: if false; // somente Cloud Functions / Callable
        allow delete: if isMaster(tid);
      }

      // Fila de cadência — somente Cloud Functions escrevem
      match /cadence_queues/{sdrId} {
        allow read:   if isManager(tid) || (isTenant(tid) && request.auth.uid == sdrId);
        allow write:  if false;

        match /daily/{date} {
          allow read:   if isManager(tid) || (isTenant(tid) && request.auth.uid == sdrId);
          allow write:  if false;
        }
      }

      // Templates de Playbook
      match /templates/{templateId} {
        allow read:   if isOperational(tid) && canAccessDocProduct(resource.data);
        allow write:  if isManager(tid) && requestProductAllowed();
      }

      // Gamificação — Moedas (ledger imutável, somente Cloud Functions escrevem)
      match /coin_ledger/{txId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        allow write:  if false;
      }

      // Prêmios e resgates
      match /prizes/{prizeId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        allow write:  if isManager(tid) && requestProductAllowed();
      }
      match /coin_redemptions/{redemptionId} {
        allow read:   if (isManager(tid) || (isTenant(tid) && request.auth.uid == resource.data.userId)) && canAccessDocProduct(resource.data);
        allow create: if isOperational(tid) && requestProductAllowed();
        allow update: if isManager(tid) && canAccessDocProduct(resource.data) && requestProductAllowed();
        allow delete: if isMaster(tid);
      }

      // Comissões — gerente/master registram e editam; o próprio beneficiário lê seu registro
      match /commissions/{commissionId} {
        allow read:   if isManager(tid)
                         || (isTenant(tid) && request.auth.uid in resource.data.beneficiaryIds);
        allow create: if isManager(tid);
        allow update: if isManager(tid);
        allow delete: if isMaster(tid);
      }

      // Fila de avaliação de comissão (dia 10) — só Cloud Functions escrevem
      match /commission_queues/{cicloKey} {
        allow read:  if isManager(tid);
        allow write: if false;
      }

      // ── Captação de Leads (WizMart Forms) ─────────────────────────────────
      // Fontes de captação: gerenciadas pelo master/manager na UI.
      // Só o hash SHA-256 da chave é armazenado (a chave em claro nunca).
      match /lead_sources/{sourceId} {
        allow read:   if isManager(tid);
        allow create: if isManager(tid);
        allow update: if isManager(tid);
        allow delete: if isMaster(tid);
      }

      // Leads brutos: escrita EXCLUSIVA da Cloud Function captureLead (Admin SDK)
      match /leads/{leadId} {
        allow read:  if isManager(tid);
        allow write: if false;
      }

      // Notificações in-app: usuário lê as próprias e só pode marcar como lida
      match /notifications/{notificationId} {
        allow read:   if isTenant(tid) && resource.data.userId == request.auth.uid;
        allow update: if isTenant(tid) && resource.data.userId == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false; // somente Cloud Functions
      }

      // KPI Snapshots
      match /kpi_snapshots/{snapshotId} {
        allow read:   if isAnyRole(tid) && canAccessDocProduct(resource.data);
        allow write:  if false; // somente Cloud Functions
      }

      // KPIs legados
      match /kpis/{period} {
        allow read:   if isAnyRole(tid);
        allow write:  if false;
      }

      // Gamificação v1
      match /gamification/{userId} {
        allow read:   if isAnyRole(tid);
        allow write:  if false;
      }
      match /achievements/{achievementId} {
        allow read:   if isAnyRole(tid);
        allow write:  if false;
      }

      // Tokens de Calendar OAuth (somente o próprio usuário ou master)
      match /calendar_tokens/{userId} {
        allow read:   if isMaster(tid) || (isTenant(tid) && request.auth.uid == userId);
        allow write:  if false; // somente Cloud Functions HTTP
      }

      // Eventos de pagamento
      match /payment_events/{eventId} {
        allow read:   if isManager(tid);
        allow write:  if false; // somente webhook Cloud Function
      }

      // Configuração de cadência — gestão (manager/master) programa a régua
      // dos SDRs e o SLA dos Reps manualmente (Observações do cliente, jul/2026).
      // Leitura liberada pro SDR também (24/08/2026): a sequência de contato
      // configurada aqui precisa aparecer como orientação na tela dele.
      match /settings/cadence {
        allow read:   if isSdr(tid);
        allow write:  if isManager(tid);
      }

      // Configurações e Integrações (somente master)
      match /settings/{docId} {
        allow read:   if isMaster(tid);
        allow write:  if isMaster(tid);
      }

      // Links de TV
      match /tv_links/{linkId} {
        allow read:          if isManager(tid) && canAccessDocProduct(resource.data);
        allow create, update: if isManager(tid) && requestProductAllowed();
        // Delete (revogar) não tem request.resource.data — valida pelo doc existente.
        allow delete:        if isManager(tid) && canAccessDocProduct(resource.data);
      }

      // ── v3: Metas por usuário ──────────────────────────────────────────────
      // Apenas master/manager escrevem; operacionais leem (SDR/Rep veem suas próprias metas)
      match /user_goals/{userId} {
        allow read:   if isOperational(tid) || (isTenant(tid) && request.auth.uid == userId);
        allow write:  if isManager(tid);
      }

      // ── v3: Projetos de Layout ─────────────────────────────────────────────
      // Operacional cria; design atualiza status (in_progress / delivered); master deleta
      match /project_requests/{requestId} {
        allow read:   if isAnyRole(tid);
        allow create: if isOperational(tid)
                      && request.resource.data.requestedBy == request.auth.uid;
        allow update: if isManager(tid)
                      || (isDesign(tid) && (
                            resource.data.status == 'pending'
                            || resource.data.get('assignedToDesignerId', '') == request.auth.uid
                         ));
        allow delete: if isMaster(tid);
      }

      // ── v3: Timeline do Deal ───────────────────────────────────────────────
      // Leitura para quem pode ver deals; escrita exclusiva via Cloud Functions
      match /deal_timeline/{dealId} {
        // Espelha a leitura do deal pai: quem sai de participantIds (Rep que
        // recusou, SDR substituído) deixa de ver o histórico daquele card também.
        allow read:   if canReadDeals(tid, get(/databases/$(database)/documents/tenants/$(tid)/deals/$(dealId)).data);

        match /events/{eventId} {
          allow read:   if canReadDeals(tid, get(/databases/$(database)/documents/tenants/$(tid)/deals/$(dealId)).data);
          allow write:  if false; // somente Cloud Functions
        }
      }
    }

    // ── Rate limit do endpoint público de leads (coleção raiz) ───────────────
    // Somente a Cloud Function captureLead (Admin SDK) lê/escreve.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
