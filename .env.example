# ── Configuração do Firebase (cliente web) ──
# Estes valores são PÚBLICOS por design (ficam embutidos no bundle do site).
# A segurança vem das regras do Firestore/RTDB, não de esconder estas chaves.
# Copie este arquivo para `.env` e preencha com os valores do seu projeto Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=

# URL base das Cloud Functions (sem barra no final).
# Padrão: https://southamerica-east1-<PROJECT_ID>.cloudfunctions.net
VITE_FUNCTIONS_URL=
