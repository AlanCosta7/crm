{
  "name": "wizmart-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "firebase deploy --project codifyx7",
    "hosting": "npx firebase deploy --only hosting --project codifyx7",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "emulators": "npm --prefix functions run build && JAVA_HOME=$(/usr/libexec/java_home -v 21) firebase emulators:start --project demo-wizmart-crm-local",
    "emulators:seed": "node scripts/seed-emulators.mjs",
    "emulators:seed:comissoes": "node scripts/seed-comissoes.mjs",
    "seed:prod-demo": "node scripts/seed-prod-demo.mjs",
    "seed:prod-demo:purge": "node scripts/seed-prod-demo.mjs --purge",
    "backfill:product-scope": "node scripts/backfill-product-scope.mjs",
    "test:e2e:local": "npm --prefix functions run build && JAVA_HOME=$(/usr/libexec/java_home -v 21) firebase emulators:exec --project demo-wizmart-crm-local \"npm run emulators:seed && npm run test:e2e\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.100.14",
    "date-fns": "^4.3.0",
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/animejs": "^3.1.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "animejs": "^3.2.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
